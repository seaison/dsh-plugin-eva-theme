{
  "name": "dsh-plugin-eva-theme",
  "version": "0.52.0",
  "description": "DSH / DeepSeek Harness EVA 主题插件：明日香暗色、绫波丽亮色，包含驾驶员选择、启动语音、时钟和音乐播放器",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "skin",
    "eva",
    "magi",
    "nerv",
    "evangelion",
    "dsh-desktop",
    "dsh-theme",
    "asuka",
    "ayanami-rei"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/animations",
    "assets/audio",
    "assets/images",
    "assets/svg",
    "assets/workers",
    "assets/manifest.json",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md",
    "docs/assets.md",
    "docs/boot-music.md",
    "docs/architecture.md",
    "docs/macos-window-drag.md",
    "docs/performance.md",
    "docs/performance",
    "docs/prompts",
    "CONTRIBUTING.md",
    "docs/release.md",
    "docs/theme-tokens.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "docs": "node tools/build-docs.mjs",
    "check": "node tools/build-assets.mjs --check && node tests/verify-gif-timing.mjs && node --check lib/client.js && node --check < lib/system-nowplaying.jxa && node --check lib/host-assets.mjs && node --check lib/index.js && node --check lib/host-balance.mjs && node --check lib/host-nowplaying.mjs && node --check lib/host-nowplaying-win.mjs && node tools/build-docs.mjs --check && node tests/verify-docs.mjs",
    "test": "npm run test:manifest && npm run test:tokens && npm run test:contrast && npm run test:host && npm run test:assets && npm run test:client && npm run test:window-drag && npm run test:attention && npm run test:boot && npm run test:layout",
    "test:manifest": "node tests/verify-manifest.mjs",
    "test:tokens": "node tests/verify-tokens.mjs",
    "test:contrast": "node tests/verify-contrast.mjs",
    "test:client": "node tools/run-browser-tests.mjs",
    "test:attention": "node tools/run-browser-tests.mjs --attention",
    "prepublishOnly": "npm run check && npm test",
    "test:host": "node tests/verify-host.mjs && node tests/verify-host-routes.mjs",
    "test:layout": "node tools/run-layout-tests.mjs",
    "test:boot": "node tools/run-layout-tests.mjs --boot",
    "build": "node tools/build-assets.mjs && node tools/build-docs.mjs",
    "test:assets": "node tests/verify-assets.mjs && node tests/verify-contours.mjs",
    "preview": "node tools/preview.mjs",
    "perf:boot": "node tools/measure-boot.mjs",
    "release": "node tools/package-release.mjs",
    "test:window-drag": "node tools/run-browser-tests.mjs --window-drag"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seaison/dsh-plugin-eva-theme.git"
  },
  "homepage": "https://github.com/seaison/dsh-plugin-eva-theme#readme",
  "bugs": {
    "url": "https://github.com/seaison/dsh-plugin-eva-theme/issues"
  },
  "license": "MIT"
}
